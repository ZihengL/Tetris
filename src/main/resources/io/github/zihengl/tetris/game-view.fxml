<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Rectangle?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.github.zihengl.tetris.controllers.GamepaneController">

    <!--GRID-->
    <GridPane fx:id="gridpane"/>

    <!--HUD-->
    <VBox alignment="CENTER"
          minWidth="100"
          spacing="20"
          style="-fx-background-color: #3D3D3D;
                 -fx-border-color: #6C6C6C;
                 -fx-border-width: 1;
                 -fx-border-style: solid;
                 -fx-padding: 10;">

        <!--PEEK QUEUE-->
        <VBox fx:id="peekbox"
              alignment="CENTER"
              style="-fx-background-color: #E7E7E7;
                     -fx-background-radius: 10;
                     -fx-border-color: #6E6E6E;
                     -fx-border-width: 3;
                     -fx-border-radius: 5;
                     -fx-border-style: solid;">
            <Text text="QUEUE"
                  style="-fx-fill: #3D3D3D;
                         -fx-font-size: 18px;
                         -fx-font-weight: bold;"/>
        </VBox>

        <Rectangle height="50"/>

        <!--SCORE-->
        <fx:include fx:id="scorebox" source="hud-component.fxml"/>
        <fx:include fx:id="levelbox" source="hud-component.fxml"/>
        <fx:include fx:id="linesbox" source="hud-component.fxml"/>
    </VBox>
</HBox>
