<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.StackPane?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.github.zihengl.tetris.controllers.MainController"
      fx:id="mainpane"
      alignment="CENTER" spacing="20.0"
      style="-fx-background-color: lightgrey;">

    <StackPane fx:id="stacks">
        <fx:include fx:id="gamepane" source="game-view.fxml"/>
        <fx:include fx:id="menupane" source="menu-view.fxml" visible="false"/>
    </StackPane>
</VBox>
